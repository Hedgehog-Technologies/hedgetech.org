---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { GAMES } from '../../lib/site';
import { getProjects } from '../../lib/projects';

export function getStaticPaths() {
  return GAMES.map((g) => ({ params: { game: g.id }, props: { game: g } }));
}
const { game } = Astro.props;
const projects = (await getProjects()).filter((p) => p.data.game === game.id);
---
<Base title={game.name} description={`Hedgehog Technologies ${game.name} mods and tools.`}>
  <div class="container">
    <p class="crumbs"><a href="/">Home</a> / {game.name}</p>
    <h1>{game.emoji} {game.name}</h1>
    <p class="lead">{game.blurb}</p>
    {projects.length === 0 ? <p>Nothing here yet — check back soon.</p> : (
      <div class="grid">
        {projects.map((p) => (
          <ProjectCard slug={p.slug} title={p.data.title} summary={p.data.summary} game={p.data.game} kind={p.data.kind} stars={p.repo?.stargazers_count} version={p.release?.tag_name} />
        ))}
      </div>
    )}
  </div>
</Base>
