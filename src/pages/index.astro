---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { GAMES, ORG_URL } from '../lib/site';
import { getProjects } from '../lib/projects';
import { getOrgRepos, fmtDate } from '../lib/github';

const projects = await getProjects();
const documented = new Set(projects.map((p) => p.data.repo?.toLowerCase()).filter(Boolean));
const others = (await getOrgRepos())
  .filter((r) => !r.fork && !r.archived && !r.name.startsWith('.') && !documented.has(r.name.toLowerCase()))
  .filter((r) => r.description)
  .sort((a, b) => b.pushed_at.localeCompare(a.pushed_at));
---
<Base>
  <div class="container">
    <section class="hero">
      <h1>Mods &amp; tools, documented.</h1>
      <p>Everything from Hedgehog Technologies in one place: guides, downloads and release info for our mods and tools across Minecraft, GTA V and Stardew Valley.</p>
      <a class="btn" href="#projects">Browse projects</a>
      <a class="btn ghost" href={ORG_URL} rel="noopener">View on GitHub</a>
    </section>

    <h2>Pick a game</h2>
    <div class="grid">
      {GAMES.map((g) => (
        <a class="card" href={`/games/${g.id}/`}>
          <span class="emoji" aria-hidden="true">{g.emoji}</span>
          <h3>{g.name}</h3>
          <p>{g.blurb}</p>
          <div class="stats"><span>{projects.filter((p) => p.data.game === g.id).length} projects</span></div>
        </a>
      ))}
    </div>

    <h2 id="projects">All projects</h2>
    <div class="grid">
      {projects.map((p) => (
        <ProjectCard slug={p.slug} title={p.data.title} summary={p.data.summary} game={p.data.game} kind={p.data.kind} stars={p.repo?.stargazers_count} version={p.release?.tag_name} />
      ))}
    </div>

    {others.length > 0 && (
      <>
        <h2>More from the organization</h2>
        <p class="lead">Other repositories, kept up to date automatically from GitHub.</p>
        <div class="grid">
          {others.map((r) => (
            <a class="card" href={r.html_url} rel="noopener">
              <div class="meta">{r.language && <span class="badge alt">{r.language}</span>}</div>
              <h3>{r.name}</h3>
              <p>{r.description}</p>
              <div class="stats"><span>Updated {fmtDate(r.pushed_at)}</span>{r.stargazers_count > 0 && <span>★ {r.stargazers_count}</span>}</div>
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</Base>
